{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Garbage King AI handoff 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "created_at", "author", "status", "branch", "base_commit", "previous_handoffs", "request", "summary", "changes", "decisions", "contracts", "tests", "risks", "next_steps", "recovery"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "author": {
      "type": "object", "additionalProperties": false, "required": ["human", "tool", "model"],
      "properties": {"human": {"$ref": "#/$defs/text"}, "tool": {"$ref": "#/$defs/text"}, "model": {"$ref": "#/$defs/text"}}
    },
    "status": {"enum": ["done", "partial", "blocked"]},
    "branch": {"$ref": "#/$defs/text"},
    "base_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "previous_handoffs": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "request": {"$ref": "#/$defs/text"},
    "summary": {"$ref": "#/$defs/text"},
    "changes": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "summary"], "properties": {
        "path": {"$ref": "#/$defs/text"}, "kind": {"enum": ["added", "modified", "deleted"]}, "summary": {"$ref": "#/$defs/text"}
      }}
    },
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "contracts": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["area", "summary", "breaking_change"], "properties": {
        "area": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "breaking_change": {"type": "boolean"}
      }}
    },
    "tests": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["command", "working_directory", "result", "summary"], "properties": {
        "command": {"$ref": "#/$defs/text"}, "working_directory": {"$ref": "#/$defs/text"}, "result": {"enum": ["passed", "failed", "not_run"]}, "summary": {"$ref": "#/$defs/text"}
      }}
    },
    "risks": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "next_steps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["priority", "task", "acceptance"], "properties": {
      "priority": {"enum": ["P1", "P2", "P3"]}, "task": {"$ref": "#/$defs/text"}, "acceptance": {"$ref": "#/$defs/text"}
    }}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["strategy", "notes"], "properties": {
      "strategy": {"enum": ["git_revert", "restore_backup", "manual", "not_applicable"]}, "notes": {"$ref": "#/$defs/text"}
    }}
  },
  "$defs": {"text": {"type": "string", "minLength": 1}}
}
